    },
    {
      "id": "ziwei.quanshu.dedifugui.014",
      "title": "十二宫诸星得地富贵论·其十四",
      "original": "天机坐卯贵，寅月六丁荣，",
      "vernacular": "天机坐卯为贵；寅月、丁年生人荣显。",
      "notes": "六丁：丁年生人。",
      "doubts": [
        "「寅月」是否实指正月，未见本句说明，保留待核。"
      ],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "branches": [
            "卯"
          ],
          "stars": [
            "天机"
          ],
          "note": "所列星曜任一颗；其余限定参原文。"
        },
        {
          "module": "ziwei",
          "note": "「寅月六丁荣」的寅月条件尚无月份键，不省掉寅月只配丁年。"
        }
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dedifugui.015",
      "title": "十二宫诸星得地富贵论·其十五",
      "original": "巨卯逢左右，六乙立边庭，",
      "vernacular": "巨门在卯逢左右，乙年生人可立功边庭。",
      "notes": "六乙：乙年生人。",
