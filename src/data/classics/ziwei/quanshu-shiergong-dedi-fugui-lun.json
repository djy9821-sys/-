          ],
          "stars": [
            "武曲"
          ],
          "note": "所列星曜任一颗；其余限定参原文。",
          "yearGan": "甲"
        }
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dedifugui.013",
      "title": "十二宫诸星得地富贵论·其十三",
      "original": "贪狼居卯酉，遇火作公卿，",
      "vernacular": "贪狼居卯酉，遇火星可为公卿。",
      "notes": "公卿：高官的统称。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "branches": [
            "卯",
            "酉"
