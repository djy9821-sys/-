    },
    {
      "id": "ziwei.quanshu.dedifugui.009",
      "title": "十二宫诸星得地富贵论·其九",
      "original": "亥宫天府天梁吉，子宫机宿亦中平，",
      "vernacular": "天府、天梁在亥宫吉利；天机在子宫也算中平。",
      "notes": "机宿：天机。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "branches": [
            "亥"
          ],
          "stars": [
            "天府",
            "天梁"
          ],
          "note": "所列星曜任一颗；其余限定参原文。"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "branches": [
            "子"
          ],
          "stars": [
            "天机"
          ],
          "note": "所列星曜任一颗；其余限定参原文。"
        }
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dedifugui.010",
      "title": "十二宫诸星得地富贵论·其十",
      "original": "七杀子午逢左右，文曲加之格最清，",
      "vernacular": "七杀在子午逢左辅、右弼，再加文曲，格局最清。",
      "notes": "左右：左辅、右弼。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "branches": [
            "子",
            "午"
          ],
          "star": "七杀",
          "meetAll": [
            "左辅",
            "右弼",
            "文曲"
          ]
        }
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dedifugui.011",
      "title": "十二宫诸星得地富贵论·其十一",
      "original": "廉坐中宫逢辅弼，更兼化吉祸尤兴。",
      "vernacular": "廉贞坐中宫逢辅弼，再兼化吉，祸事尤其兴起。",
      "notes": "辅弼：左辅、右弼。",
      "doubts": [
        "「中宫」「祸尤兴」均照录；后者与化吉语境相反，疑有讹字，未改作福。"
      ],
      "applies": [
        {
          "module": "ziwei",
          "note": "「中宫」未明，且化吉而祸兴文义可疑，不硬配。"
        }
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dedifugui.012",
      "title": "十二宫诸星得地富贵论·其十二",
      "original": "武曲巳亥逢，六甲帅边庭，",
      "vernacular": "武曲在巳亥，甲年生人可统帅边庭。",
      "notes": "六甲：甲年生人；边庭：边境。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "branches": [
