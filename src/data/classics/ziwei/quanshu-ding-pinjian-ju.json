    {
      "id": "ziwei.quanshu.dingpinjianju.001",
      "title": "定贫贱局·生不逢时",
      "original": "生不逢时：命坐空亡，逢廉贞是也。",
      "vernacular": "生不逢时格：命宫落入空亡之地，且逢廉贞星坐守即是此格。",
      "notes": "廉贞为囚星，坐命本忌凶曜，若再落入地空、地劫或截空旬空等空亡之位，主生不逢时、怀才不遇。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "廉贞"
        }
      ],
      "tags": [
        "定贫贱局",
        "廉贞",
        "生不逢时"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dingpinjianju.002",
      "title": "定贫贱局·禄逢两杀",
      "original": "禄逢两杀：禄坐空亡，又逢空劫杀星是也。",
      "vernacular": "禄逢两杀格：禄存坐于空亡之位，又逢地空、地劫与凶煞之星同宫冲会即是此格。",
      "notes": "禄存最怕逢空劫，称两重华盖或两煞冲破，虚名虚利，财来财去。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "禄存"
        }
      ],
      "tags": [
        "定贫贱局",
        "禄存",
        "地空",
        "地劫",
        "禄逢两杀"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dingpinjianju.003",
      "title": "定贫贱局·马落空亡",
      "original": "马落空亡：马既落亡，虽禄冲会无用，主奔波。",
      "vernacular": "马落空亡格：天马星落入空亡之位，此时虽然有禄存来相冲相会也没有用处，主人终身徒劳奔波。",
      "notes": "天马逢地空地劫或截路旬空，虽有禄马交驰之象，但因落空而徒劳无功，主浮沉流浪。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "天马"
        }
      ],
      "tags": [
        "定贫贱局",
        "天马",
        "马落空亡"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.dingpinjianju.004",
      "title": "定贫贱局·日月藏辉",
      "original": "日月藏辉：日月反背，又逢巨暗是也。",
      "vernacular": "日月藏辉格：太阳太阴反背失陷（如日落戌亥子、月落卯辰巳），且又逢巨门暗星同宫冲会即是此格。",
      "notes": "日月失辉，更逢暗宿巨门遮蔽，主一生多劳碌晦滞、眼目昏暗。",
      "doubts": [],
      "applies": [
