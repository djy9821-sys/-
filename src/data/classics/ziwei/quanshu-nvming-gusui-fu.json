    {
      "id": "ziwei.quanshu.nvming.001",
      "title": "女命骨髓赋·其一",
      "original": "府相之星女命躔，必当子贵与夫贤。",
      "vernacular": "天府、天相坐守女命，必定儿子显贵、丈夫贤良。",
      "notes": "「府相之星」天府为令星，天相为印星，女命逢之主贤淑福厚、子贵夫贤。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "天府",
            "天相"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.002",
      "title": "女命骨髓赋·其二",
      "original": "廉贞清白能相守，更有天同理亦然。",
      "vernacular": "有廉贞，便能保持清白；再有天同，也是这样的道理。",
      "notes": "「廉贞清白」廉贞在未申庙地独坐，女命清白守节。「天同」福德主，女命主温和安享福禄。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "廉贞",
            "天同"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.003",
      "title": "女命骨髓赋·其三",
      "original": "端正紫微太阳星，早遇贤夫性可凭。",
      "vernacular": "紫微、太阳使人端正，早早遇到贤良的丈夫，其性情值得信赖。",
      "notes": "紫微为帝座，太阳为主夫之宿，二星入庙守女命主早适贵夫。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "紫微",
            "太阳"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.004",
      "title": "女命骨髓赋·其四",
      "original": "太阳寅到午，遇吉终是福。",
      "vernacular": "太阳在寅到午之间，遇到吉星，终究会有福气。",
      "notes": "「太阳寅到午」寅卯辰巳午五宫太阳庙旺，日光充沛，利于女命招得贵夫。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "太阳"
          ],
          "brightness": "庙"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.005",
      "title": "女命骨髓赋·其五",
      "original": "左辅天魁为福寿，右弼天相福来临。",
      "vernacular": "左辅、天魁主有福有寿；右弼、天相主福气到来。",
      "notes": "辅弼魁钺为四辅吉星，天相为印星，女命得之主旺夫益家。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "左辅",
            "天魁"
          ],
          "note": "左辅、天魁任一颗守命"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "右弼",
            "天相"
          ],
          "note": "右弼、天相任一颗守命"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.006",
      "title": "女命骨髓赋·其六",
      "original": "禄存厚重多衣食，府相朝垣命必荣。",
      "vernacular": "禄存主为人厚重、衣食丰富；天府、天相朝垣，必定荣显。",
      "notes": "「禄存厚重」禄存主厚重财帛。「府相朝垣格」天府天相在三方朝会命宫，女命逢之大吉。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "star": "禄存"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "pattern": "府相朝垣格"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.007",
      "title": "女命骨髓赋·其七",
      "original": "紫府巳亥相互辅，左右扶持福必生。",
      "vernacular": "紫微、天府在巳亥互相辅助，左辅、右弼扶持，必定会有福气。",
      "notes": "巳亥二宫紫府对拱，得左右夹辅，女命主一生大贵。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "branches": [
            "巳",
            "亥"
          ],
          "stars": [
            "紫微",
            "天府"
          ],
          "meet": [
            "左辅",
            "右弼"
          ],
          "note": "紫府巳亥相互辅：紫微或天府（任一颗，紫微巳则天府亥）守命，左辅或右弼扶持"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.008",
      "title": "女命骨髓赋·其八",
      "original": "巨门天机为破荡。天梁月曜女命贫。",
      "vernacular": "巨门、天机主破败放荡；天梁、太阴主女命贫穷。",
      "notes": "「巨机破荡」巨门天机居酉陷地主浮荡。「天梁月曜」梁阴居巳亥陷宫主贫困孤单。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "allStars": [
            "巨门",
            "天机"
          ],
          "note": "巨门天机同宫（卯酉）守命为破荡"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "天梁",
            "太阴"
          ],
          "brightness": [
            "陷"
          ],
          "note": "天梁月曜女命贫：天梁或太阴落陷守命（两星不同宫，任一颗）"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.009",
      "title": "女命骨髓赋·其九",
      "original": "擎羊火星为下贱。文昌文曲福不全。",
      "vernacular": "擎羊、火星主地位低贱；文昌、文曲主福分不全。",
      "notes": "「文昌文曲福不全」古诀称女命单见昌曲无主星统摄恐风流多情红颜薄命。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "擎羊",
            "火星"
          ],
          "note": "擎羊、火星任一颗守命为下贱"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "文昌",
            "文曲"
          ],
          "note": "文昌、文曲任一颗守命福不全"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.010",
      "title": "女命骨髓赋·其十",
      "original": "武曲之宿为寡宿。破军一曜性难明。",
      "vernacular": "武曲是寡宿，破军则使人的性情难以捉摸。",
      "notes": "「寡宿」武曲性刚杀伐，古法多以女命武曲太刚克夫为寡宿。「破军性难明」破军任性妄为性格难辨。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "star": "武曲",
          "note": "武曲之宿为寡宿"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "star": "破军",
          "note": "破军一曜性难明"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.011",
      "title": "女命骨髓赋·其十一",
      "original": "贪狼内狠多淫佚。七杀沉吟福不荣。",
      "vernacular": "贪狼主内心狠毒、多放纵淫欲；七杀主迟疑不定，福分不丰。",
      "notes": "「贪狼多淫佚」贪狼陷地坐女命主多情放纵。「七杀沉吟」七杀陷地主愁闷不乐、身心艰辛。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "贪狼",
            "七杀"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.012",
      "title": "女命骨髓赋·其十二",
      "original": "十干化禄最荣昌，女命逢之大吉昌。更得禄存相凑合，旺夫益子受恩光。",
      "vernacular": "十干化禄最为荣华昌盛，女命遇到就十分吉利。再有禄存会合，便能帮助丈夫、惠及子女，得到恩惠。",
      "notes": "「十干化禄与禄存」双禄交会于女命主旺夫益子、持家有道。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "禄存"
          ],
          "mutagen": "禄"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.013",
      "title": "女命骨髓赋·其十三",
      "original": "火铃羊陀及巨门，天空地劫又相临。贪狼七杀廉贞宿，武曲加临克害侵。",
      "vernacular": "火星、铃星、擎羊、陀罗及巨门，又有天空、地劫同来，再加贪狼、七杀、廉贞、武曲，便受到克害。",
      "notes": "本节总括女命最忌惮之煞曜组合：火铃羊陀巨门空劫，及杀破廉贪武曲孤克刚煞。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "star": [
            "火星",
            "铃星",
            "擎羊",
            "陀罗",
            "巨门"
          ],
          "stars": [
            "地空",
            "地劫"
          ],
          "note": "火铃羊陀巨门任一颗守命，又有天空（地空）或地劫相临"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "star": [
            "贪狼",
            "七杀",
            "廉贞"
          ],
          "stars": "武曲",
          "note": "贪狼七杀廉贞任一颗与武曲同守命宫（武贪丑未、武杀卯酉）"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.014",
      "title": "女命骨髓赋·其十四",
      "original": "三方四正嫌逢杀，更在夫宫祸患深。若是本宫无正曜，必主生离克害真。",
      "vernacular": "三方四正怕遇杀星，杀星再到夫宫，祸患更深。本宫若无正曜，必有生离与克害。",
      "notes": "「夫宫」即夫妻宫，古法论女命以夫妻宫为重中之重，最忌见煞且无正曜坐守。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": [
            "命宫",
            "夫妻"
          ],
          "meet": [
            "擎羊",
            "陀罗",
            "火星",
            "铃星"
          ],
          "note": "三方四正嫌逢杀，更在夫宫祸患深；四煞任一颗会照"
        },
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "夫妻",
          "empty": "无正曜",
          "note": "末句：夫妻宫没有主星，主生离克害"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.015",
      "title": "女命骨髓赋·其十五",
      "original": "已前论赋俱系看命要诀，学者宜熟玩之，乃得原委也。",
      "vernacular": "前面这些论、赋都是看命的要诀，学习者应反复研读体会，才能明白来龙去脉。",
      "notes": "「已前论赋」总结卷一《太微赋》《形性赋》《斗数骨髓赋》《女命骨髓赋》四篇经典赋文，作为全书赋文之结语指南。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "note": "女命骨髓赋与前诸赋看命总诀结语"
        }
      ],
      "tags": [
        "赋文",
        "结语"
      ],
      "status": "translated"
    }
