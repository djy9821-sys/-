        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.008",
      "title": "女命骨髓赋·其八",
      "original": "巨门天机为破荡。天梁月曜女命贫。",
      "vernacular": "巨门天机主破荡，天梁月曜主女命贫困。",
      "notes": "「巨机破荡」巨门天机居酉陷地主浮荡。「天梁月曜」梁阴居巳亥陷宫主贫困孤单。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "巨门",
            "天机",
            "天梁",
            "太阴"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.009",
      "title": "女命骨髓赋·其九",
      "original": "擎羊火星为下贱。文昌文曲福不全。",
      "vernacular": "擎羊火星主下贱，文昌文曲主福不全。",
      "notes": "「文昌文曲福不全」古诀称女命单见昌曲无主星统摄恐风流多情红颜薄命。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "擎羊",
            "火星",
            "文昌",
            "文曲"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.010",
      "title": "女命骨髓赋·其十",
      "original": "武曲之宿为寡宿。破军一曜性难明。",
      "vernacular": "武曲是寡宿，破军使性情难明。",
      "notes": "「寡宿」武曲性刚杀伐，古法多以女命武曲太刚克夫为寡宿。「破军性难明」破军任性妄为性格难辨。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "武曲",
            "破军"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.011",
      "title": "女命骨髓赋·其十一",
      "original": "贪狼内狠多淫佚。七杀沉吟福不荣。",
      "vernacular": "贪狼内心狠而多淫佚，七杀沉吟，福不荣盛。",
      "notes": "「贪狼多淫佚」贪狼陷地坐女命主多情放纵。「七杀沉吟」七杀陷地主愁闷不乐、身心艰辛。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "贪狼",
            "七杀"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.012",
      "title": "女命骨髓赋·其十二",
      "original": "十干化禄最荣昌，女命逢之大吉昌。更得禄存相凑合，旺夫益子受恩光。",
      "vernacular": "十干化禄最荣昌，女命遇上大吉。再得禄存相会，旺夫益子，承受恩光。",
      "notes": "「十干化禄与禄存」双禄交会于女命主旺夫益子、持家有道。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "禄存"
          ],
          "mutagen": "禄"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.013",
      "title": "女命骨髓赋·其十三",
      "original": "火铃羊陀及巨门，天空地劫又相临。贪狼七杀廉贞宿，武曲加临克害侵。",
      "vernacular": "火铃羊陀及巨门，天空地劫又来临；贪狼七杀廉贞，武曲再临便有克害。",
      "notes": "本节总括女命最忌惮之煞曜组合：火铃羊陀巨门空劫，及杀破廉贪武曲孤克刚煞。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "火星",
            "铃星",
            "擎羊",
            "陀罗",
            "巨门",
            "地空",
            "地劫",
            "贪狼",
            "七杀",
            "廉贞",
            "武曲"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.014",
      "title": "女命骨髓赋·其十四",
      "original": "三方四正嫌逢杀，更在夫宫祸患深。若是本宫无正曜，必主生离克害真。",
      "vernacular": "三方四正忌遇杀，再到夫宫祸更深。本宫若无正曜，必有生离克害。",
      "notes": "「夫宫」即夫妻宫，古法论女命以夫妻宫为重中之重，最忌见煞且无正曜坐守。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "夫妻"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.015",
      "title": "女命骨髓赋·其十五",
      "original": "已前论赋俱系看命要诀，学者宜熟玩之，乃得原委也。",
      "vernacular": "前面的论赋都是看命要诀，学者宜熟读玩味，才能明白原委。",
      "notes": "「已前论赋」总结卷一《太微赋》《形性赋》《斗数骨髓赋》《女命骨髓赋》四篇经典赋文，作为全书赋文之结语指南。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "note": "女命骨髓赋与前诸赋看命总诀结语"
        }
      ],
      "tags": [
        "赋文",
        "结语"
      ],
      "status": "translated"
    }
  ]
