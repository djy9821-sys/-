    {
      "id": "ziwei.quanshu.nvming.001",
      "title": "女命骨髓赋·其一",
      "original": "府相之星女命躔，必当子贵与夫贤。",
      "vernacular": "府相临女命，必子贵夫贤。",
      "notes": "「府相之星」天府为令星，天相为印星，女命逢之主贤淑福厚、子贵夫贤。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "天府",
            "天相"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.002",
      "title": "女命骨髓赋·其二",
      "original": "廉贞清白能相守，更有天同理亦然。",
      "vernacular": "廉贞清白能相守，再有天同也是如此。",
      "notes": "「廉贞清白」廉贞在未申庙地独坐，女命清白守节。「天同」福德主，女命主温和安享福禄。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "廉贞",
            "天同"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.003",
      "title": "女命骨髓赋·其三",
      "original": "端正紫微太阳星，早遇贤夫性可凭。",
      "vernacular": "紫微太阳使人端正，早遇贤夫，性情可信。",
      "notes": "紫微为帝座，太阳为主夫之宿，二星入庙守女命主早适贵夫。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "紫微",
            "太阳"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.004",
      "title": "女命骨髓赋·其四",
      "original": "太阳寅到午，遇吉终是福。",
      "vernacular": "太阳在寅至午，遇吉终有福。",
      "notes": "「太阳寅到午」寅卯辰巳午五宫太阳庙旺，日光充沛，利于女命招得贵夫。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "太阳"
          ],
          "brightness": "庙"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.005",
      "title": "女命骨髓赋·其五",
      "original": "左辅天魁为福寿，右弼天相福来临。",
      "vernacular": "左辅天魁主福寿，右弼天相带来福。",
      "notes": "辅弼魁钺为四辅吉星，天相为印星，女命得之主旺夫益家。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "左辅",
            "天魁",
            "右弼",
            "天相"
          ]
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.006",
      "title": "女命骨髓赋·其六",
      "original": "禄存厚重多衣食，府相朝垣命必荣。",
      "vernacular": "禄存厚重，衣食丰富；府相朝垣，命必荣显。",
      "notes": "「禄存厚重」禄存主厚重财帛。「府相朝垣格」天府天相在三方朝会命宫，女命逢之大吉。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "禄存",
            "天府",
            "天相"
          ],
          "pattern": "府相朝垣格"
        }
      ],
      "tags": [
        "赋文",
        "女命"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.nvming.007",
      "title": "女命骨髓赋·其七",
      "original": "紫府巳亥相互辅，左右扶持福必生。",
      "vernacular": "紫府在巳亥互辅，左右扶持必有福。",
      "notes": "巳亥二宫紫府对拱，得左右夹辅，女命主一生大贵。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "gender": "女",
          "palace": "命宫",
          "stars": [
            "紫微",
            "天府",
            "左辅",
            "右弼"
          ]
        }
      ],
      "tags": [
