        "相貌",
        "性情"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.xingxing.003",
      "title": "形性赋·其三",
      "original": "贪狼为善恶之星，入庙必应长耸，出垣必定顽嚣。巨门乃是非之曜，在庙敦厚温良。天相精神，天梁稳重，心事玉洁冰清。",
      "vernacular": "贪狼兼有善恶，入庙必使身材高大，出垣必使人顽劣喧闹。巨门是是非之星，入庙使人敦厚温良。天相使人有精神，天梁使人稳重，心地冰清玉洁。",
      "notes": "「长耸」身材修长耸拔。「出垣」出离庙垣，指落入陷地。「玉洁冰清」形容天相天梁纯正无私。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "贪狼",
          "note": "贪狼善恶入庙出垣"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "巨门",
          "note": "巨门在庙敦厚"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "天相",
          "note": "天相精神"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "天梁",
          "note": "天梁稳重"
        }
      ],
      "tags": [
        "赋文",
        "相貌",
        "性情"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.xingxing.004",
      "title": "形性赋·其四",
      "original": "七杀如子路暴虎冯河，火铃似豫让吞炭装哑。暴虎冯河兮目太凶狠，吞炭装哑兮暗狼声沉。",
      "vernacular": "七杀像子路徒手搏虎、涉河冒险，火星铃星像豫让吞炭装哑。前者眼神格外凶狠，后者暗狼而声音低沉。",
      "notes": "「子路暴虎冯河」典出《论语》，喻凭血气之勇冒险。「豫让吞炭装哑」战国豫让为复仇吞炭毁声。",
      "doubts": [
        "「暗狼」字样照留，未径改暗狠。"
      ],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "七杀",
          "note": "七杀暴虎冯河"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": [
            "火星",
            "铃星"
          ],
          "note": "火铃任一颗，吞炭装哑"
        }
      ],
      "tags": [
        "赋文",
        "性情"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.xingxing.005",
      "title": "形性赋·其五",
      "original": "俊雅文昌眉清目秀，磊落文曲口舌便佞，在庙定生异痣，失陷必有斑痕。左辅右弼温良规模，端庄高士。天魁天钺具足威仪，重合三台则十全模范。",
      "vernacular": "文昌使人俊雅、眉清目秀；文曲使人磊落，巧言善辩而善于逢迎，入庙必生异痣，失陷必有斑痕。左辅右弼使人温良端庄，像高士；天魁天钺使人威仪齐备，再会三台，形貌便十全十美。",
      "notes": "「异痣」吉相之善痣。「便佞」此处指口齿伶俐、言辞便给。「三台」三台八座吉曜。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "文昌",
          "note": "文昌俊雅"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "文曲",
          "note": "文曲磊落"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": [
            "左辅",
            "右弼"
          ],
          "note": "辅弼任一颗温良"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": [
            "天魁",
            "天钺"
          ],
          "note": "魁钺任一颗具足威仪"
        }
      ],
      "tags": [
        "赋文",
        "相貌"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.xingxing.006",
      "title": "形性赋·其六",
      "original": "擎羊陀罗，形丑貌粗，有矫诈体态。破军不仁，背重眉宽，行坐腰斜奸诈好行惊险。性貌如春和蔼，乃是禄存之情德。情怀似火锋冲，此诚破耗之威权。",
      "vernacular": "擎羊陀罗使人身形丑陋、面貌粗野，体态矫诈。破军使人不仁厚，背厚眉宽，走路坐下时腰身倾斜，奸诈而爱冒险。性貌像春天般和蔼，是禄存的德性；心性像火一样猛烈冲动，是破耗的威势。",
      "notes": "「背重」厚背或驼背。「破耗」指大耗小耗或破军星之凶耗性情。",
      "doubts": [],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": [
            "擎羊",
            "陀罗"
          ],
          "note": "羊陀任一颗形丑貌粗"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "破军",
          "note": "破军不仁"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "禄存",
          "note": "禄存性貌如春"
        }
      ],
      "tags": [
        "赋文",
        "相貌",
        "性情"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.xingxing.007",
      "title": "形性赋·其七",
      "original": "星论庙旺最怕空亡，杀落空亡竟无威力。权禄乃九窍之奇，耗积散平生之福。禄逢梁荫抱私财益与他人，耗遇贪狼浽淫情于井底。贪星入于马垣易善易恶，恶曜扶同善曜禀性不常。",
      "vernacular": "论星的庙旺，最怕空亡；煞落空亡，便没有威力。权禄使九窍灵巧，耗积散去一生福气。禄遇天梁荫星，拿自己的财物帮助他人；耗遇贪狼，浽淫情于井底。贪狼入马垣，容易变善变恶；恶星与善星相扶，会使人性情无常。",
      "notes": "「九窍之奇」指聪明智慧开窍。「马垣」指寅申巳亥四马之地。「浽淫情于井底」指暗昧不可告人之情欲。",
      "doubts": [
        "「浽淫情于井底」字句古刻本亦见作『淫情』或『妥淫情』，按公版本文校勘。",
        "「浽淫情于井底」保留原串，不据旧注改写成未见于原文的隐情细节。",
        "「耗积散平生之福」中「耗积」断读未明，白话保留此词，不删「积」而解释为耗散殆尽。"
      ],
      "applies": [
        {
          "module": "ziwei",
          "palace": "命宫",
          "mutagenAll": [
            "权",
            "禄"
          ],
          "note": "权禄乃九窍之奇"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "天梁",
          "stars": [
            "禄存"
          ],
          "note": "禄逢梁荫"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "star": "破军",
          "meet": [
            "贪狼"
          ],
          "note": "耗遇贪狼；二星不同宫，按会照"
        },
        {
          "module": "ziwei",
          "palace": "命宫",
          "allStars": [
            "贪狼",
            "天马"
          ],
          "note": "贪星入于马垣"
        },
        {
          "module": "ziwei",
          "note": "星论庙旺、空亡及恶曜扶同善曜：未点星名不强配"
        }
      ],
      "tags": [
        "赋文",
        "性情"
      ],
      "status": "translated"
    },
    {
      "id": "ziwei.quanshu.xingxing.008",
      "title": "形性赋·其八",
      "original": "财居空亡巴三览四，文曲旺宫闻一知十。暗合廉贞为贪滥之曹吏。身命司数实奸盗之技儿，猪屠之流。善禄定是奇高之艺细巧，伶俐之人。",
      "vernacular": "财居空亡，会说话东拉西扯；文曲在旺宫，能闻一知十。暗与廉贞相合，会做贪婪无度的官府文吏。身命司数，会是奸盗技儿、杀猪之人。善禄使人技艺高超，是精巧伶俐的人。",
      "notes": "「巴三览四」贪多不实、四处抓揽。「曹吏」衙门胥吏。「司数」指主贱役之煞曜星数。",
